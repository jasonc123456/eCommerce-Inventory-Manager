{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    // The DOM library is needed because `page.evaluate` bodies are compiled
    // here but run in the browser. The suite itself is a Node process; these
    // are the only fragments of it that are not.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
