{
  "name": "@eim/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "PostgreSQL schema, forward migrations, and typed query access.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx src/cli/migrate.ts",
    "build": "esbuild src/cli/migrate.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/migrate.js --sourcemap"
  },
  "dependencies": {
    "@eim/config": "workspace:*",
    "@eim/observability": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "esbuild": "0.25.12"
  }
}
