# Installation configuration for eCommerce Inventory Manager.
#
# GENERATED FILE. Edit packages/config/src/schema.ts and packages/config/src/fields.ts,
# then run: pnpm env:check --write
#
# Copy to the deployment root as .env, fill in real values, and restrict it:
#   cp .env.example /path/to/deployment/.env && chmod 600 /path/to/deployment/.env
#
# The real .env lives at the deployment root, outside this repository (D-092).
# Never commit a filled-in copy. Every value marked "secret" below must never
# appear in logs, exports, diagnostics, screenshots, or the web UI.

#
# Runtime mode. Production enables the strict HTTPS, proxy, and
# file-permission checks.
NODE_ENV=production

# [required in production]
# Canonical public origin. Must be HTTPS in production. Used for OAuth
# callbacks, webhook destinations, WebAuthn relying-party identity, and email
# links.
EIM_PUBLIC_URL=https://inventory.example.com

# [secret] [required in production]
# PostgreSQL 18 connection string. Must reach the database directly: a
# transaction-pooling proxy breaks LISTEN/NOTIFY live updates (D-140).
EIM_DATABASE_URL=postgresql://eim:CHANGE_ME@postgres:5432/eim

# [secret] [required in production]
# Keyed-hash secret for session tokens and authentication challenges. At least
# 32 characters.
EIM_SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# [secret] [required in production]
# Versioned AES-256-GCM master keyring as JSON: [{"version":1,"key":"<base64
# 32 bytes>"}]. Rotation adds a version; old versions stay until no live data
# or retained backup needs them (D-069).
EIM_KEYRING=[{"version":1,"key":"CHANGE_ME_base64_of_32_random_bytes"}]

#
# Which keyring version encrypts new values. Must exist in EIM_KEYRING.
EIM_KEYRING_ACTIVE_VERSION=1

# [required in production]
# SMTP server for authentication, invitation, security, and alert mail.
EIM_SMTP_HOST=smtp.office365.com

#
# SMTP port.
EIM_SMTP_PORT=587

# [sensitive]
# SMTP username. Omit only for a relay that authenticates by network.
EIM_SMTP_USER=inventory@example.com

# [secret]
# SMTP password or application password.
EIM_SMTP_PASSWORD=CHANGE_ME

# [required in production]
# Envelope and header sender address.
EIM_MAIL_FROM_ADDRESS=inventory@example.com

#
# Display name on outbound mail.
EIM_MAIL_FROM_NAME=Inventory Manager

# [sensitive]
# Address permitted to claim the first installation administrator. Bootstrap
# closes permanently after a successful claim.
EIM_INITIAL_ADMIN_EMAIL=admin@example.com

# [secret]
# High-entropy one-time bootstrap secret. Remove it from this file after the
# first administrator exists.
EIM_SETUP_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# [sensitive]
# eBay Sandbox keyset application ID. Sandbox and Production are strictly
# isolated.
EIM_EBAY_SANDBOX_CLIENT_ID=CHANGE_ME

# [secret]
# eBay Sandbox keyset certificate ID.
EIM_EBAY_SANDBOX_CLIENT_SECRET=CHANGE_ME

# [sensitive]
# eBay Sandbox RuName bound to this deployment public URL.
EIM_EBAY_SANDBOX_RUNAME=CHANGE_ME

# [sensitive]
# eBay Production keyset application ID.
EIM_EBAY_PRODUCTION_CLIENT_ID=CHANGE_ME

# [secret]
# eBay Production keyset certificate ID.
EIM_EBAY_PRODUCTION_CLIENT_SECRET=CHANGE_ME

# [sensitive]
# eBay Production RuName bound to this deployment public URL.
EIM_EBAY_PRODUCTION_RUNAME=CHANGE_ME

# [secret]
# Random 32 to 80 character token matching the eBay marketplace
# account-deletion endpoint configuration. Required before Production eBay use
# (section 13).
EIM_EBAY_DELETION_VERIFICATION_TOKEN=CHANGE_ME_32_to_80_random_characters_no_spaces

#
# Host UID owning every bind-mounted data directory. Containers run as this
# user so data stays readable without sudo (D-142).
EIM_DATA_UID=1000

#
# Host GID owning every bind-mounted data directory (D-142).
EIM_DATA_GID=1000

#
# Public key backups encrypt to. The matching private key must be held off
# this host, or the control is defeated (D-143).
EIM_BACKUP_PUBLIC_KEY=age1CHANGE_ME

#
# Comma-separated networks whose forwarded headers are trusted. Empty means
# trust none, which is correct when nothing proxies this deployment.
EIM_TRUSTED_PROXY_CIDRS=172.16.0.0/12

#
# Opt in to private-network integration destinations for a self-hosted
# WooCommerce or local Ollama. Disabled by default; never permits
# cloud-metadata targets (D-071).
EIM_ALLOW_PRIVATE_INTEGRATION_HOSTS=false

#
# Exact private hosts or CIDRs permitted when the flag above is enabled.
EIM_PRIVATE_HOST_ALLOWLIST=192.168.1.50,10.0.0.0/24

#
# Where a sign-in link carries its token. `fragment` keeps it out of every
# log; `query` is for installations whose mail gateway rewrites links and
# drops the fragment (section 19).
EIM_MAGIC_LINK_TOKEN_CARRIER=fragment

#
# Baseline log level. Debug and trace change detail, never redaction policy
# (section 22).
EIM_LOG_LEVEL=info

#
# Build identifier, stamped on every log line, metric, and scheduler lease.
# Set by the container image so a mixed-version rollout is visible.
EIM_APP_VERSION=0.1.0
